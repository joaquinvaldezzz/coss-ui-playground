{
  "printWidth": 100,
  "plugins": [
    "@prettier/plugin-oxc",
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-jsdoc",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "^(react/(.*)$)|^(react$)",
    "^(@tanstack/(.*)$)|^(@tanstack$)",
    "<THIRD_PARTY_MODULES>",
    "",
    "<TYPES>^(react/(.*)$)|^(react$)",
    "<TYPES>^(@tanstack/(.*)$)|^(@tanstack$)",
    "<TYPES>",
    "<TYPES>^@/types/(.*)$",
    "^@/config/(.*)$",
    "^@/lib/(.*)$",
    "^@/hooks/(.*)$",
    "^@/components/ui/(.*)$",
    "^@/components/(.*)$",
    "^@/styles/(.*)$",
    "",
    "<TYPES>^[./]",
    "^[./]"
  ],
  "tailwindAttributes": [],
  "tailwindStylesheet": "src/styles.css",
  "tailwindFunctions": ["cn", "cva"]
}
